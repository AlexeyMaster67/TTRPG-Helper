{"manifest": {"id": "cyberpunk_red_starter", "name": "Cyberpunk RED: 25 Archetypes Starter Pack", "system_id": "cyberpunk_red", "edition": "Core Rulebook System", "version": "1.0.0", "author": "R. Talsorian Games / Night City Community Archetypes", "description": "25 каноничных боевых архетипов Night City: Соло, Нетраннеры, Техники, Номады, Полиция, Мальстрём, Киберпсихопат, МаксТак, Арасака и Травма Тим со статистикой REF, броней SP головы/тела и арсеналом оружия.", "count": 25, "format": "ait-content-pack-v1", "created_at": "2026-10-18T23:06:58.094Z", "tags": ["cyberpunk", "cyberpunk_red", "starter", "archetypes", "night_city"], "license": "Fan Content / Core Reference"}, "creatures": [{"id": "cpr-solo-street-veteran", "name": "Соло (Ветеран Улиц)", "name_en": "Solo (Street Veteran)", "name_ru": "Соло (Ветеран Улиц)", "system_id": "cyberpunk_red", "systemId": "cyberpunk_red", "systemVersion": "1.0.0", "role": "Solo", "creature_type": "Humanoid", "creature_type_ru": "Человек (Соло)", "size": "Medium", "size_ru": "Средний", "stats": {"ref": 8, "dex": 8, "body": 8, "will": 6, "int": 6, "tech": 4, "cool": 7, "luck": 5, "move": 6, "emp": 3, "headSp": 11, "bodySp": 11, "hp": 45, "maxHp": 45}, "resources": {"hp": {"current": 45, "max": 45}, "spHead": {"current": 11, "max": 11}, "spBody": {"current": 11, "max": 11}}, "tracks": {"humanity": {"name": "Человечность", "current": 30, "max": 30}, "deathSave": {"name": "Спасбросок смерти (Body)", "current": 8, "max": 8}}, "defenses": {"damageImmunities": [], "damageResistances": [], "damageVulnerabilities": [], "conditionImmunities": [], "damageReductions": {"head": 11, "body": 11}}, "actions": [{"id": "act-assault-rifle", "name": "Штурмовая винтовка (Assault Rifle)", "actionType": "action", "attackBonus": 14, "reachRange": "До 50 м", "damageDice": "5d6", "damageType": "kinetic", "description": "ROF 1, одиночный или подавляющий огонь (10 патронов). При пробитии SP броня разрушается на 1 SP."}, {"id": "act-vheavy-pistol", "name": "Очень тяжелый пистолет (Very Heavy Pistol)", "actionType": "action", "attackBonus": 14, "reachRange": "До 25 м", "damageDice": "4d6", "damageType": "kinetic", "description": "ROF 1. Калибр .454 Casull. Ударная останавливающая мощь на ближней дистанции."}, {"id": "act-combat-awareness", "name": "Чутьё в бою (Combat Awareness)", "actionType": "passive", "description": "Ранг роли Соло: +2 к инициативе, +1 к прицельным атакам (Headshots)."}], "notes": "Опытный наёмник Корпоратских войн. Киберимпланты: Киберочи (Low Light, Smartlink), Керензиков (+2 инициатива), Подкожная защита.", "customFields": {"gear": "Легкий бронекостюм (SP11), Аптечка, 60 патронов к винтовке, 16 патронов к пистолету"}, "ac": 10, "hp_average": 45, "cr": "1", "cr_or_level": "1"}, {"id": "cpr-netrunner-black-ice", "name": "Нетраннер (Спец по Black ICE)", "name_en": "Netrunner (Black ICE Runner)", "name_ru": "Нетраннер (Спец по Black ICE)", "system_id": "cyberpunk_red", "systemId": "cyberpunk_red", "systemVersion": "1.0.0", "role": "Netrunner", "creature_type": "Humanoid", "creature_type_ru": "Человек (Нетраннер)", "size": "Medium", "size_ru": "Средний", "stats": {"ref": 6, "dex": 6, "body": 5, "will": 7, "int": 8, "tech": 7, "cool": 6, "luck": 6, "move": 5, "emp": 5, "headSp": 7, "bodySp": 7, "hp": 40, "maxHp": 40}, "resources": {"hp": {"current": 40, "max": 40}, "spHead": {"current": 7, "max": 7}, "spBody": {"current": 7, "max": 7}}, "tracks": {"humanity": {"name": "Человечность", "current": 50, "max": 50}, "deathSave": {"name": "Спасбросок смерти (Body)", "current": 5, "max": 5}}, "defenses": {"damageImmunities": [], "damageResistances": [], "damageVulnerabilities": [], "conditionImmunities": [], "damageReductions": {"head": 7, "body": 7}}, "actions": [{"id": "act-heavy-pistol", "name": "Тяжелый пистолет (Heavy Pistol)", "actionType": "action", "attackBonus": 10, "reachRange": "До 25 м", "damageDice": "3d6", "damageType": "kinetic", "description": "ROF 2. Компактный смарт-пистолет со сбросом гильз."}, {"id": "act-net-interface", "name": "Сетевой взлом (Interface NET Action)", "actionType": "action", "attackBonus": 14, "reachRange": "В пределах 6 м от точки доступа", "damageDice": "3d6", "damageType": "cyber_damage", "description": "Атака программами Sword / Worm против точек доступа NET-архитектуры и киберимплантов противника."}, {"id": "act-emp-grenade", "name": "ЭМИ граната (EMP Grenade)", "actionType": "action", "attackBonus": 10, "reachRange": "Бросок до 15 м", "damageDice": "0d6", "damageType": "emp", "description": "Отключает кибернетику и дронов в радиусе 6 м на 1 минуту при провале спасброска DV15."}], "notes": "Хакер корпоративных сетей. Кибердека Кироши 'Excalibur', Нейроинтерфейс, Виртуальный дисплей Кироши.", "customFields": {"gear": "Кевларовый жилет (SP7), Кибердека, 3 программы Black ICE (Hellhound, Sword, Shield)"}, "ac": 10, "hp_average": 40, "cr": "1", "cr_or_level": "1"}, {"id": "cpr-tech-gunsmith", "name": "Техник (Оружейник Улиц)", "name_en": "Tech (Street Gunsmith)", "name_ru": "Техник (Оружейник Улиц)", "system_id": "cyberpunk_red", "systemId": "cyberpunk_red", "systemVersion": "1.0.0", "role": "Tech", "creature_type": "Humanoid", "creature_type_ru": "Человек (Техник)", "size": "Medium", "size_ru": "Средний", "stats": {"ref": 6, "dex": 7, "body": 6, "will": 5, "int": 8, "tech": 8, "cool": 5, "luck": 5, "move": 5, "emp": 6, "headSp": 7, "bodySp": 11, "hp": 40, "maxHp": 40}, "resources": {"hp": {"current": 40, "max": 40}, "spHead": {"current": 7, "max": 7}, "spBody": {"current": 11, "max": 11}}, "tracks": {"humanity": {"name": "Человечность", "current": 60, "max": 60}, "deathSave": {"name": "Спасбросок смерти (Body)", "current": 6, "max": 6}}, "defenses": {"damageImmunities": [], "damageResistances": [], "damageVulnerabilities": [], "conditionImmunities": [], "damageReductions": {"head": 7, "body": 11}}, "actions": [{"id": "act-shotgun", "name": "Дробовик (Shotgun)", "actionType": "action", "attackBonus": 12, "reachRange": "До 25 м", "damageDice": "5d6", "damageType": "kinetic", "description": "ROF 1. Картечь (конус 3х3 м, 3d6 всем) или пуля (5d6 по одиночной цели)."}, {"id": "act-heavy-pistol", "name": "Модифицированный пистолет", "actionType": "action", "attackBonus": 11, "reachRange": "До 25 м", "damageDice": "3d6", "damageType": "kinetic", "description": "ROF 2. Точный самодельный пистолет с компенсатором отдачи."}, {"id": "act-field-repair", "name": "Полевой ремонт брони (Field Armor Patch)", "actionType": "action", "description": "Восстанавливает 2 SP повреждённой брони союзника за 1 действие прямо в бою."}], "notes": "Мастер по кастомизации оружия и брони. Встроенный киберинструмент в указательный палец, защитные очки сварщика.", "customFields": {"gear": "Легкий бронекостюм (SP11), Набор инструментов, Паяльная станция, Запасные детали"}, "ac": 10, "hp_average": 40, "cr": "1", "cr_or_level": "1"}, {"id": "cpr-nomad-road-warrior", "name": "Номад (Воин Пустошей)", "name_en": "Nomad (Road Warrior)", "name_ru": "Номад (Воин Пустошей)", "system_id": "cyberpunk_red", "systemId": "cyberpunk_red", "systemVersion": "1.0.0", "role": "Nomad", "creature_type": "Humanoid", "creature_type_ru": "Человек (Номад)", "size": "Medium", "size_ru": "Средний", "stats": {"ref": 7, "dex": 7, "body": 7, "will": 6, "int": 5, "tech": 6, "cool": 6, "luck": 6, "move": 7, "emp": 5, "headSp": 11, "bodySp": 11, "hp": 45, "maxHp": 45}, "resources": {"hp": {"current": 45, "max": 45}, "spHead": {"current": 11, "max": 11}, "spBody": {"current": 11, "max": 11}}, "tracks": {"humanity": {"name": "Человечность", "current": 50, "max": 50}, "deathSave": {"name": "Спасбросок смерти (Body)", "current": 7, "max": 7}}, "defenses": {"damageImmunities": [], "damageResistances": [], "damageVulnerabilities": [], "conditionImmunities": [], "damageReductions": {"head": 11, "body": 11}}, "actions": [{"id": "act-sniper-rifle", "name": "Снайперская винтовка (Sniper Rifle)", "actionType": "action", "attackBonus": 13, "reachRange": "До 100 м", "dam