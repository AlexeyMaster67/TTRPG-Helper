, "reachRange": "Ближний бой", "damageDice": "1d6", "damageType": "piercing", "description": "Выдвигается из трости или рукава дорогого пальто."}, {"id": "act-street-deal", "name": "Сделка на месте (Operator / Greasework)", "actionType": "action", "description": "Умение достать любое снаряжение, оружие или подкупить охранника за секунды."}], "notes": "Знает всех в районе Уотсон. Записная книжка с компроматом, три защищенных спутниковых телефона.", "customFields": {"gear": "Стильное пальто с кевларовым подкладом (SP7), 10 000 эдди на кредитных чипах, Шифрованный телефон"}, "ac": 10, "hp_average": 40, "cr": "1", "cr_or_level": "1"}, {"id": "cpr-boosterganger-maelstrom", "name": "Бустерганжер (Банда Мальстрём)", "name_en": "Boosterganger (Maelstrom Thug)", "name_ru": "Бустерганжер (Банда Мальстрём)", "system_id": "cyberpunk_red", "systemId": "cyberpunk_red", "systemVersion": "1.0.0", "role": "Boosterganger", "creature_type": "Cyborg", "creature_type_ru": "Киборг-бандит", "size": "Medium", "size_ru": "Средний", "stats": {"ref": 6, "dex": 6, "body": 8, "will": 5, "int": 4, "tech": 3, "cool": 4, "luck": 3, "move": 6, "emp": 2, "headSp": 7, "bodySp": 11, "hp": 45, "maxHp": 45}, "resources": {"hp": {"current": 45, "max": 45}, "spHead": {"current": 7, "max": 7}, "spBody": {"current": 11, "max": 11}}, "tracks": {"humanity": {"name": "Человечность", "current": 20, "max": 20}, "deathSave": {"name": "Спасбросок смерти (Body)", "current": 8, "max": 8}}, "defenses": {"damageImmunities": [], "damageResistances": ["pain"], "damageVulnerabilities": ["emp"], "conditionImmunities": [], "damageReductions": {"head": 7, "body": 11}}, "actions": [{"id": "act-cyber-claws", "name": "Кибер-когти / Рипперы (Cyber-Rippers)", "actionType": "action", "attackBonus": 12, "reachRange": "Ближний бой", "damageDice": "3d6", "damageType": "slashing", "description": "ROF 2. Молибденовые выдвижные лезвия из пальцев. Игнорируют половину брони SP."}, {"id": "act-heavy-smg", "name": "Тяжелый ПП (Heavy SMG)",