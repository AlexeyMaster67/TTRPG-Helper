{"manifest": {"id": "pathfinder2e_starter", "name": "Pathfinder 2e (PF2e) Starter Bestiary", "system_id": "pathfinder2e", "edition": "Remastered (ORC License)", "version": "1.0.0", "author": "Paizo Inc. / Open RPG Creative License (ORC)", "description": "25 базовых существ тактической системы Pathfinder 2e с трехдейственной экономикой ([1-Действие], [2-Действия], [3-Действия], [Реакция]): Гоблины, Орки, Скелеты, Зомби, Лютоволки, Тролли, Драконы и Гаргульи.", "count": 25, "format": "ait-content-pack-v1", "created_at": "2026-10-22T02:10:05.956Z", "tags": ["pathfinder", "pf2e", "starter", "three_actions", "orc_license"], "license": "ORC License"}, "creatures": [{"id": "pf2e-goblin-warrior", "name": "Гоблин-воин (Goblin Warrior)", "name_en": "Goblin Warrior", "name_ru": "Гоблин-воин", "system_id": "pathfinder2e", "systemId": "pathfinder2e", "systemVersion": "1.0.0", "level": -1, "cr_or_level": "-1", "creature_type": "Humanoid", "creature_type_ru": "Гуманоид (Гоблин)", "size": "Small", "size_ru": "Маленький", "stats": {"str": 0, "dex": 3, "con": 1, "int": 0, "wis": -1, "cha": -1, "ac": 16, "level": -1, "perception": 3, "fortitude": 5, "reflex": 7, "will": 3, "speed": 25}, "resources": {"hp": {"current": 16, "max": 16}}, "defenses": {"damageImmunities": [], "damageResistances": [], "damageVulnerabilities": [], "conditionImmunities": [], "damageReductions": {}}, "actions": [{"id": "act-dogslicer", "name": "[1-Действие] Удар Собакорезом (Dogslicer)", "actionType": "action", "attackBonus": 8, "reachRange": "5 фт.", "damageDice": "1d6", "damageType": "slashing", "description": "Фехтовальное, Быстрое (Agile, Finesse). Наносит дополнительно 1d6 режущего при критическом ударе."}, {"id": "act-shortbow", "name": "[1-Действие] Выстрел из короткого лука (Shortbow)", "actionType": "action", "attackBonus": 8, "reachRange": "60 фт.", "damageDice": "1d6", "damageType": "piercing", "description": "Дальнобойное оружие, смертельное d10."}, {"id": "act-goblin-scuttle", "name": "[Реакция] Гоблинская увёртка (Goblin Scuttle)", "actionType": "reaction", "description": "Триггер: союзник заканчивает движение рядом с гоблином. Гоблин совершает Шаг (Step) на 5 фт без провокации атак."}], "notes": "Классический гоблин из Pathfinder 2e. Верткий и трусливый в одиночку, опасный в стае.", "customFields": {"traits": ["goblin", "humanoid"], "economy": "three_action"}, "ac": 10, "hp_average": 16, "cr": "-1"}, {"id": "pf2e-goblin-pyro", "name": "Гоблин-пироман (Goblin Pyro)", "name_en": "Goblin Pyro", "name_ru": "Гоблин-пироман", "system_id": "pathfinder2e", "systemId": "pathfinder2e", "systemVersion": "1.0.0", "level": 1, "cr_or_level": "1", "creature_type": "Humanoid", "creature_type_ru": "Гуманоид (Гоблин)", "size": "Small", "size_ru": "Маленький", "stats": {"str": -1, "dex": 3, "con": 1, "int": 1, "wis": 0, "cha": 3, "ac": 17, "level": 1, "perception": 5, "fortitude": 4, "reflex": 8, "will": 5, "speed": 25}, "resources": {"hp": {"current": 15, "max": 15}}, "defenses": {"damageImmunities": [], "damageResistances": ["fire 3"], "damageVulnerabilities": [], "conditionImmunities": [], "damageReductions": {}}, "actions": [{"id": "act-torch", "name": "[1-Действие] Удар факелом (Torch Strike)", "actionType": "action", "attackBonus": 6, "reachRange": "5 фт.", "damageDice": "1d4-1", "damageType": "bludgeoning", "description": "+1 урон огнем. Цель может загореться."}, {"id": "act-produce-flame", "name": "[2-Действия] Сотворение пламени (Produce Flame)", "actionType": "action", "attackBonus": 8, "reachRange": "30 фт.", "damageDice": "1d4+3", "damageType": "fire", "description": "Заклинание огня. Критический успех наносит 1d4 периодического огненного урона."}, {"id": "act-burning-hands", "name": "[2-Действия] Огненные ладони (Burning Hands)", "actionType": "action", "hitDc": 17, "saveStat": "reflex", "reachRange": "Конус 15 фт.", "damageDice": "2d6", "damageType": "fire", "description": "Спасбросок Рефлексов DC 17. Базовый спасбросок."}], "notes": "Одержимый огнем гоблин-колдун, обожающий поджигать всё вокруг.", "customFields": {"traits": ["goblin", "humanoid"], "economy": "three_action"}, "ac": 10, "hp_average": 15, "cr": "1"}, {"id": "pf2e-orc-brute", "name": "Орк-громила (Orc Brute)", "name_en": "Orc Brute", "name_ru": "Орк-громила", "system_id": "pathfinder2e", "systemId": "pathfinder2e", "systemVersion": "1.0.0", "level": 0, "cr_or_level": "0", "creature_type": "Humanoid", "creature_type_ru": "Гуманоид (Орк)", "size": "Medium", "size_ru": "Средний", "stats": {"str": 3, "dex": 2, "con": 2, "int": -1, "wis": 0, "cha": -1, "ac": 15, "level": 0, "perception": 4, "fortitude": 6, "reflex": 4, "will": 2, "speed": 25}, "resources": {"hp": {"current": 15, "max": 15}}, "defenses": {"damageImmunities": [], "damageResistances": [], "damageVulnerabilities": [], "conditionImmunities": [], "damageReductions": {}}, "actions": [{"id": "act-greataxe", "name": "[1-Действие] Взмах секирой (Greataxe Strike)", "actionType": "action", "attackBonus": 7, "reachRange": "5 фт.", "damageDice": "1d12+3", "damageType": "slashing", "description": "Свирепый удар двуручной секирой (Разверзший удар, Sweep)."}, {"id": "act-javelin", "name": "[1-Действие] Бросок дротика (Javelin)", "actionType": "action", "attackBonus": 5, "reachRange": "30 фт.", "damageDice": "1d6+3", "damageType": "piercing", "description": "Метательное оружие."}, {"id": "act-orc-ferocity", "name": "[Реакция] Орочья свирепость (Orc Ferocity)", "actionType": "reaction", "description": "Триггер: здоровье падает до 0 HP. Орк остается на 1 HP и получает статус Wounded 1."}], "notes": "Мускулистый свирепый орк, отказывающийся умирать от первой же смертельной раны.", "customFields": {"traits": ["orc", "humanoid"], "economy": "three_action"}, "ac": 10, "hp_average": 15, "cr": "0"}, {"id": "pf2e-orc-warrior", "name": "Орк-воитель (Orc Warrior)", "name_en": "Orc Warrior", "name_ru": "Орк-воитель", "system_id": "pathfinder2e", "systemId": "pathfinder2e", "systemVersion": "1.0.0", "level": 1, "cr_or_level": 