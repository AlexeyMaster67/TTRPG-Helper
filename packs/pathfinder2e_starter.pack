rcing 5", "slashing 5"], "damageVulnerabilities": ["bludgeoning 5"], "conditionImmunities": ["unconscious"], "damageReductions": {}}, "actions": [{"id": "act-scimitar", "name": "[1-Действие] Удар скимитаром (Scimitar)", "actionType": "action", "attackBonus": 6, "reachRange": "5 фт.", "damageDice": "1d6+2", "damageType": "slashing", "description": "Фехтовальное, Широкий замах (Forceful, Sweep)."}, {"id": "act-claw", "name": "[1-Действие] Коготь (Claw Strike)", "actionType": "action", "attackBonus": 6, "reachRange": "5 фт.", "damageDice": "1d4+2", "damageType": "slashing", "description": "Быстрое (Agile)."}], "notes": "Ожившие кости древнего воина. Уязвимы к дробящему оружию (молоты и булавы).", "customFields": {"traits": ["mindless", "skeleton", "undead"], "economy": "three_action"}, "ac": 10, "hp_average": 9, "cr": "-1"}, {"id": "pf2e-zombie-shambler", "name": "Зомби-шаркун (Zombie Shambler)", "name_en": "Zombie Shambler", "name_ru": "Зомби-шаркун", "system_id": "pathfinder2e", "systemId": "pathfinder2e", "systemVersion": "1.0.0", "level": -1, "cr_or_level": "-1", "creature_type": "Undead", "creature_type_ru": "Нежить (Зомби)", "size": "Medium", "size_ru": "Средний", "stats": {"str": 3, "dex": -2, "con": 2, "int": -5, "wis": 0, "cha": -2, "ac": 12, "level": -1, "perception": 0, "fortitude": 6, "reflex": 0, "will": 2, "speed": 25}, "resources": {"hp": {"current": 20, "max": 20}}, "defenses": {"damageImmunities": ["bleed", "death effects", "disease", "mental", "paralyzed", "poison"], "damageResistances": [], "damageVulnerabilities": ["slashing 5"], "conditionImmunities": ["unconscious"], "damageReductions": {}}, "actions": [{"id": "act-slam", "name": "[1-Действие] Тяжелый удар (Slam)", "actionType": "action", "attackBonus": 7, "reachRange": "5 фт.", "damageDice": "1d6+3", "damageType": "bludgeoning", "description": "При успехе зомби может выполнить Захват (Grab) за 1 действие."}, {"id": "act-jaws", "name": "[1-Действие] Укус челюстями (Jaws)", "actionType": "action", "attackBonus": 7, "reachRange": "5 фт.", "damageDice": "1d8+3", "damageType": "piercing", "description": "Может применяться против схваченной цели."}, {"id": "act-slow", "name": "[Пассивное] Замедленный (Permanently Slowed 1)", "actionType": "passive", "description": "Зомби постоянно находится под эффектом Slowed 1 — у него только 2 действия за раунд вместо 3!"}], "notes": "Гниющее ходячее тело. Постоянно замедлен, но обладает запасом живучести.", "customFields": {"traits": ["mindless", "undead", "zombie"], "economy": "three_action"}, "ac": 10, "hp_average": 20, "cr": "-1"}, {"id": "pf2e-animated-armor", "name": "Оживленный доспех (Animated Armor)", "name_en": "Animated Armor", "name_ru": "Оживленный доспех", "system_id": "pathfinder2e", "systemId": "pathfinder2e", "systemVersion": "1.0.0", "level": 2, "cr_or_level": "2", "creature_type": "Construct", "creature_type_ru": "Конструкт", "size": "Medium", "size_ru": "Средний", "stats": {"str": 3, "dex": -1, "con": 3, "int": -5, "wis": 0, "cha": -5, "ac": 17, "level": 2, "perception": 6, "fortitude": 9, "reflex": 3, "will": 4, "speed": 20}, "resources": {"hp": {"current": 20, "max": 20}}, "defenses": {"damageImmunities": ["bleed", "death effects", "disease", "healing", "mental", "poison"], "damageResistances": [], "damageVulnerabilities": [], "conditionImmunities": ["fatigued", "paralyzed", "unconscious"], "damageReductions": {"hardness": 6}}, "actions": [{"id": "act-greatsword", "name": "[1-Действие] Удар двуручным мечом (Greatsword)", "actionType": "action", "attackBonus": 11, "reachRange": "5 фт.", "damageDice": "1d12+4", "damageType": "slashing", "description": "Широкий рубящий удар конструктного стража."}], "notes": "Магический латный доспех, оживленный волей чародея для охраны сокровищницы. Твердость 6 (Hardness 6).", "customFields": {"traits": ["construct", "mindless"], "economy": "three_action"}, "ac": 10, "hp_average": 20, "cr": "2"}, {"id": "pf2e-wolf", "name": "Волк (Wolf)", "name_en": "Wolf", "name_ru": "Волк", "system_id": "pathfinder2e", "systemId": "pathfinder2e", "systemVersion": "1.0.0", "level": 1, "cr_or_level": "1", "creature_type": "Beast", "creature_type_ru": "Зверь", "size": "Medium", "size_ru": "Средний", "stats": {"str": 2, "dex": 4, "con": 2, "int": -4, "wis": 2, "cha": -2, "ac": 15, "level": 1, "perception": 7, "fortitude": 7, "reflex": 9, "will": 5, "speed": 35}, "resources": {"hp": {"current": 24, "max": 24}}, "defenses": {"damageImmunities": [], "damageResistances": [], "damageVulnerabilities": [], "conditionImmunities": [], "damageReductions": {}}, "actions": [{"id": "act-jaws", "name": "[1-Действие] Укус челюстями (Jaws)", "actionType": "action", "attackBonus": 7, "reachRange": "5 фт.", "damageDice": "1d6+2", "damageType": "piercing", "description": "Сбивание с ног (Knockdown): при попадании волк может потратить 1 действие на сбивание цели с ног."}, {"id": "act-pack-attack", "name": "[Пассивное] Стайная атака (Pack Attack)", "actionType": "passive", "description": "Волк наносит дополнительно 1d4 урона целям, находящимся в зоне досягаемости как минимум двух его союзников."}], "notes": "Хищник леса, охотящийся слаженными стаями.", "customFields": {"traits": ["animal"], "economy": "three_action"}, "ac": 10, "hp_average": 24, "cr": "1"}, {"id": "pf2e-dire-wolf", "name": "Лютоволк (Dire Wolf)", "name_en": "Dire Wolf", "name_ru": "Лютоволк", "system_id": "pathfinder2e", "systemId": "pathfinder2e", "systemVersion": "1.0.0", "level": 3, "cr_or_level": "3", "creature_type": "Beast", "creature_type_ru": "Зверь (Лютый)", "size": "Large", "size_ru": "Крупный", "stats": {"str": 4, "dex": 3, "con": 3, "int": -4, "wis": 2, "cha": -2, "ac": 18, "level": 3, "perception": 9, "fortitude": 10, "reflex": 10, "will": 7, "speed": 35}, "resources": {"hp": {"current": 50, "max": 50}}, "defenses": {"damageImmunities": [], "damageResistances": [], "damageVulnerabilities": [], "conditionImmunities": [], "damageReductions": {}}, "actions": [{"id": "act-jaws-dire", "name": "[1-Де